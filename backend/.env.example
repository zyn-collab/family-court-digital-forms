# Family Court digital forms — backend settings
# Copy to .env and load it in the service definition (systemd EnvironmentFile=, or
# `set -a; . ./.env; set +a` before `node server.js`). Nothing here is read from a file
# by the server itself; every setting is an environment variable.

# ── where it listens ───────────────────────────────────────────────────────
FC_PORT=4000
# The web origin that may call the API (CORS). `*` is for development only.
FC_ALLOW_ORIGIN=https://forms.familycourt.gov.mv
# 1 only when a reverse proxy (nginx, IIS ARR, Caddy) sits in front and sets X-Forwarded-For.
FC_TRUST_PROXY=1
# 1 relaxes a few checks for local development. Never in production.
FC_DEV=0
# Multiplies the per-address request limits (login 5/min, status 20/min, drafts 120/min,
# submissions 20/min). Raise it (for example 10) when many testers or a whole office share
# one internet connection; the per-username login limit stays as it is.
FC_RATE_SCALE=1

# ── storage ────────────────────────────────────────────────────────────────
# json (flat files, fine for the pilot) or sqlite (one database file, recommended).
FC_STORE=sqlite
FC_DB_PATH=/var/lib/familycourt/familycourt.db
# used by the json store only
FC_DATA_DIR=/var/lib/familycourt/data
# attachments are written here as files, one folder per reference number
FC_UPLOADS_DIR=/var/lib/familycourt/uploads
FC_MAX_FILE_MB=10

# ── backups (node backup.js) ───────────────────────────────────────────────
FC_BACKUP_DIR=/var/backups/familycourt
FC_BACKUP_UPLOADS=1

# ── notifications (notify.js) ──────────────────────────────────────────────
# Every SMS/email is appended to this file whether or not a gateway is set.
FC_OUTBOX_PATH=/var/lib/familycourt/outbox.jsonl
# HTTP endpoints that receive one JSON message per SMS / email (see docs/INTEGRATION_HANDOVER.md).
# Leave empty until the Court's gateway is known; messages still go to the outbox.
FC_SMS_WEBHOOK=
FC_EMAIL_WEBHOOK=
# sent as `Authorization: Bearer …` to both webhooks when set
FC_WEBHOOK_TOKEN=
# the public site, used in the message text for the status link
FC_PUBLIC_SITE=https://forms.familycourt.gov.mv

# ── events to the Court's own system (events.js) ───────────────────────────
# Every submission, status change and correction is POSTed here as JSON (the full
# record plus attachment paths; see docs/INTEGRATION_HANDOVER.md section 4). Empty = log only.
FC_EVENT_WEBHOOK=
# every event is also appended here, delivered or not
FC_EVENT_LOG_PATH=/var/lib/familycourt/events.jsonl
