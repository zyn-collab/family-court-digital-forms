# Family Court digital forms — backend settings
#
# Copy this file to backend/.env and change what you need. The server, user-cli.js and
# backup.js read backend/.env on start. A setting given by the service manager or Docker
# takes precedence over the file. Every line is optional: with no .env at all the server
# runs with the defaults shown, which suit a first local run.

# ── where it listens ───────────────────────────────────────────────────────
# FC_PORT=4000
# The backend serves the site itself (forms, status page, admin) at the same address as
# the API. Set 0 only if another web server serves app/.
# FC_SERVE_APP=1
# Only when the site is served from a different address than the API: that site's
# address, for example https://forms.familycourt.gov.mv. Leave unset otherwise.
# FC_ALLOW_ORIGIN=
# 1 when a reverse proxy (nginx, IIS, Caddy) sits in front and sets X-Forwarded-For.
# FC_TRUST_PROXY=1
# Per-connection request limits, as a multiple of a strict reference (login 5/min, status
# 20/min, drafts 120/min, submissions 20/min). The default 20 leaves a whole office behind
# one connection unaffected. 0 turns per-connection limits off. The per-account login limit
# (10 failed attempts in 10 minutes for one username) always applies.
# FC_RATE_SCALE=20

# ── storage ────────────────────────────────────────────────────────────────
# json (flat files) or sqlite (one database file, recommended for real use).
# Whatever is chosen here, user-cli.js and backup.js use the same, because they read this file.
FC_STORE=sqlite
# Defaults are inside backend/: data/familycourt.db, data/, uploads/. On a server, put
# them on a disk that is backed up, for example:
# FC_DB_PATH=/var/lib/familycourt/familycourt.db
# FC_DATA_DIR=/var/lib/familycourt/data
# FC_UPLOADS_DIR=/var/lib/familycourt/uploads
# FC_MAX_FILE_MB=10

# ── backups (node backup.js) ───────────────────────────────────────────────
# FC_BACKUP_DIR=/var/backups/familycourt
# FC_BACKUP_UPLOADS=1

# ── notifications (notify.js) ──────────────────────────────────────────────
# Every SMS/email is appended to the outbox whether or not a gateway is set
# (default data/outbox.jsonl).
# FC_OUTBOX_PATH=/var/lib/familycourt/outbox.jsonl
# HTTP endpoints that receive one JSON message per SMS / email
# (see docs/INTEGRATION_HANDOVER.md section 4). Empty: messages wait in the outbox.
# FC_SMS_WEBHOOK=
# FC_EMAIL_WEBHOOK=
# sent as "Authorization: Bearer …" to every webhook when set
# FC_WEBHOOK_TOKEN=
# the public address of the site, used for the status link in messages
# FC_PUBLIC_SITE=https://forms.familycourt.gov.mv

# ── events to the Court's own system (events.js) ───────────────────────────
# Every submission, status change and correction is POSTed here as JSON (the full record
# plus attachment paths; see docs/INTEGRATION_HANDOVER.md section 4). Empty: logged only.
# FC_EVENT_WEBHOOK=
# FC_EVENT_LOG_PATH=/var/lib/familycourt/events.jsonl
